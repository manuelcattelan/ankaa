{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "//#check-types:root": {
      "cache": false
    },
    "//#dev:tunnel": {
      "cache": false,
      "persistent": true
    },
    "//#lint:fix:root": {
      "cache": false
    },
    "//#lint:root": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["topo"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["topo"]
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["topo"],
      "passThroughEnv": [
        "AI_AGENT",
        "CLAUDE_CODE",
        "CLAUDECODE",
        "DOCKER_HOST",
        "RYUK_CONTAINER_IMAGE",
        "TESTCONTAINERS_*"
      ]
    },
    "topo": {
      "dependsOn": ["^topo"]
    }
  },
  "ui": "tui"
}
