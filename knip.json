{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["fly", "ngrok"],
  "ignoreDependencies": ["expo-updates", "pino-pretty", "shellcheck"],
  "ignoreIssues": {
    "apps/mobile/src/shared/components/animated-view.tsx": ["exports"],
    "apps/mobile/src/shared/components/icon.tsx": ["exports"],
    "apps/mobile/src/shared/core/compute-concentric-radius.ts": ["files"],
    "apps/mobile/src/shared/core/is-accessibility-category.ts": ["files"],
    "apps/mobile/src/shared/hooks/use-{color-variant,tokens}.ts": ["exports"],
    "apps/mobile/src/shared/tokens/**": ["exports", "files", "types"],
    "packages/authentication/better-auth.config.ts": ["exports"]
  },
  "workspaces": {
    "apps/mobile": {
      "entry": [
        "src/**/*.test-d.ts",
        "src/shared/components/animated-view.tsx!",
        "src/shared/components/icon.tsx!",
        "src/shared/hooks/use-{color-variant,tokens}.ts!",
        "src/shared/tokens/haptics.ts!"
      ],
      "ignoreDependencies": ["react-native-svg!"],
      "project": ["**/*.{ts,tsx}!", "!src/**/testing/**!"]
    },
    "packages/*": {
      "vitest": {
        "entry": [
          "src/**/*.test.ts",
          "src/**/*.test-d.ts",
          "src/**/testing/**/*.ts"
        ]
      }
    },
    "packages/authentication": {
      "entry": ["better-auth.config.ts"],
      "vitest": {
        "entry": [
          "src/**/*.test.ts",
          "src/**/*.test-d.ts",
          "src/**/testing/**/*.ts"
        ]
      }
    }
  }
}
