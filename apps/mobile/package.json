{
  "dependencies": {
    "@ankaa/core": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@expo/ui": "~57.0.19",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@ankaa/api": "workspace:*",
    "@ankaa/eslint": "workspace:*",
    "@ankaa/typescript": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-jest": "~29.7.0",
    "eslint": "catalog:",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "jiti": "catalog:",
    "react-test-renderer": "19.2.3",
    "typescript": "catalog:"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "jest": {
    "fakeTimers": {
      "doNotFake": [
        "setImmediate",
        "clearImmediate"
      ],
      "enableGlobally": true
    },
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/node_modules/@react-native-google-signin/google-signin/jest/build/jest/setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/testing/setup.ts"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "caller": {
            "bundler": "jest",
            "name": "metro",
            "platform": "ios"
          },
          "presets": [
            "expo/internal/babel-preset"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|effect|uuid|better-auth|@better-auth|nanostores))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "main": "expo-router/entry",
  "name": "@ankaa/mobile",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "expo start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest"
  }
}
