{
  "dependencies": {
    "@ankaa/core": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@expo/ui": "~58.0.27",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@tanstack/react-query": "^5.105.3",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@ankaa/api": "workspace:*",
    "@ankaa/eslint": "workspace:*",
    "@ankaa/typescript": "workspace:*",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "~30.5.2",
    "eslint": "catalog:",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "jiti": "catalog:",
    "test-renderer": "~1.3.1",
    "typescript": "catalog:"
  },
  "imports": {
    "#/*": "./src/*",
    "#/app.config.ts": "./app.config.ts"
  },
  "jest": {
    "fakeTimers": {
      "doNotFake": [
        "setImmediate",
        "clearImmediate"
      ],
      "enableGlobally": true
    },
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/node_modules/@react-native-google-signin/google-signin/jest/build/jest/setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/testing/setup.ts"
    ],
    "testTimeout": 30000,
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "caller": {
            "bundler": "jest",
            "name": "metro",
            "platform": "ios"
          },
          "presets": [
            "expo/internal/babel-preset"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|effect|uuid|better-auth|@better-auth|nanostores))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "main": "expo-router/entry",
  "name": "@ankaa/mobile",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "expo start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest"
  }
}
