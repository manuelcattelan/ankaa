{
  "devDependencies": {
    "@ankaa/eslint": "workspace:*",
    "@ankaa/typescript": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "knip": "^6.44.1",
    "prettier": "catalog:",
    "prettier-plugin-sh": "^0.20.2",
    "shellcheck": "^4.1.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1"
    },
    "runtime": {
      "name": "node",
      "version": ">=26"
    }
  },
  "name": "ankaa",
  "private": true,
  "scripts": {
    "check-types": "turbo run check-types check-types:root",
    "check-types:root": "tsc --noEmit",
    "check-versions:mobile": "pnpm --filter @ankaa/mobile exec expo install --check",
    "deploy:mobile": "pnpm --filter @ankaa/mobile exec eas build --platform ios --profile production --auto-submit --no-wait",
    "deploy:server": "fly deploy --config apps/server/fly.toml",
    "dev": "turbo run dev",
    "dev:tunnel": "ngrok http 8080",
    "format": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path apps/mobile/.gitignore",
    "format:fix": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path apps/mobile/.gitignore",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:fix:root",
    "lint:fix:root": "eslint . --fix",
    "lint:knip": "export APP_VARIANT=development EXPO_PUBLIC_API_URL=https://placeholder.invalid EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=placeholder.apps.googleusercontent.com DATABASE_URL_DIRECT=postgresql://placeholder.invalid/ankaa && knip --treat-config-hints-as-errors --include-entry-exports && knip --production --strict",
    "lint:root": "eslint . && git ls-files -z --cached --others --exclude-standard -- '*.sh' | xargs -0 -r shellcheck && pnpm lint:knip",
    "test": "turbo run test"
  },
  "type": "module"
}
