{
  "devDependencies": {
    "@ankaa/eslint": "workspace:*",
    "@ankaa/prettier": "workspace:*",
    "@ankaa/typescript": "workspace:*",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "prettier": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    }
  },
  "name": "ankaa",
  "private": true,
  "scripts": {
    "check-types": "turbo run check-types check-types:root",
    "check-types:root": "tsc --noEmit",
    "dev": "turbo run dev",
    "format": "turbo run format format:root",
    "format:root": "prettier --check .",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint ."
  },
  "type": "module"
}
