{
  "devDependencies": {
    "@ankaa/eslint": "workspace:*",
    "@ankaa/typescript": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-sh": "^0.19.0",
    "shellcheck": "^4.1.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4"
    },
    "runtime": {
      "name": "node",
      "version": ">=26"
    }
  },
  "name": "ankaa",
  "private": true,
  "scripts": {
    "check-types": "turbo run check-types check-types:root",
    "check-types:root": "tsc --noEmit",
    "dev": "turbo run dev",
    "dev:tunnel": "ngrok http 8080",
    "format": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path apps/mobile/.gitignore",
    "format:fix": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path apps/mobile/.gitignore",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:fix:root",
    "lint:fix:root": "eslint . --fix",
    "lint:root": "eslint . && git ls-files -z --cached --others --exclude-standard -- '*.sh' | xargs -0 -r shellcheck",
    "test": "turbo run test"
  },
  "type": "module"
}
