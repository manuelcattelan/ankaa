{
  "dependencies": {
    "@ankaa/core": "workspace:*",
    "@ankaa/database": "workspace:*",
    "@ankaa/email": "workspace:*",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/expo": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@ankaa/eslint": "workspace:*",
    "@ankaa/typescript": "workspace:*",
    "@ankaa/vitest": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "auth": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "name": "@ankaa/authentication",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "generate": "auth generate --config better-auth.config.ts --output node_modules/.cache/better-auth/authentication.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "type": "module"
}
