{
  "dependencies": {
    "@ankaa/core": "workspace:*",
    "@effect/sql-pg": "4.0.5",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@ankaa/eslint": "workspace:*",
    "@ankaa/typescript": "workspace:*",
    "@ankaa/vitest": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "name": "@ankaa/database",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "generate": "DOTENV_CONFIG_PATH=../../.env drizzle-kit generate --name",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "DOTENV_CONFIG_PATH=../../.env drizzle-kit migrate",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts",
    "test": "vitest run"
  },
  "type": "module"
}
