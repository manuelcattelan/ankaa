{
  "dependencies": {
    "@ankaa/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@ankaa/eslint": "workspace:*",
    "@ankaa/prettier": "workspace:*",
    "@ankaa/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./error": "./src/error.ts",
    "./migrations-folder-path": "./src/migrations-folder-path.ts",
    "./schema/authentication": "./src/schema/authentication.ts",
    "./schema/exercise": "./src/schema/exercise.ts",
    "./schema/routine": "./src/schema/routine.ts",
    "./schema/workout": "./src/schema/workout.ts"
  },
  "name": "@ankaa/database",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate": "drizzle-kit generate --name",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts"
  },
  "type": "module"
}
