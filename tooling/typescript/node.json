{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "isolatedModules": true,
    "module": "nodenext",
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": false
  },
  "extends": [
    "./base.json",
    "@tsconfig/node26/tsconfig.json",
    "@tsconfig/node-ts/tsconfig.json"
  ]
}
